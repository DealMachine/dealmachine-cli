  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dealmachine",
    "real-estate",
    "property-data",
    "property-intelligence",
    "lead-generation",
    "api",
    "cli",
    "enrichment"
